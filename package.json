{
  "name": "hap-mapper",
  "private": true,
  "type": "module",
  "description": "hapmap.app: a time-travel map of Canberra's historical aerial photography",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "deploy:dev": "node scripts/build.mjs && wrangler deploy --env dev"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "wrangler": "^4.68.1",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-geocoder": "1.9.4",
    "geotiff": "3.0.5",
    "maplibre-gl": "5.24.0"
  }
}
